# =====================================================================
# DeskLite — environment template.
# Copy this file to ".env" (which is git-ignored) and adjust as needed.
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
# NEVER commit a real .env. When you add a new variable in code,
# document it here in the SAME pull request.
# =====================================================================

# ---- PostgreSQL ----
POSTGRES_USER=desklite
POSTGRES_PASSWORD=devpassword_change_me
POSTGRES_DB=desklite
# Hostname "db" is the docker-compose service name (not localhost).
DATABASE_URL=postgresql+psycopg://desklite:devpassword_change_me@db:5432/desklite

# ---- Auth / JWT ----
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Set the Secure flag on auth cookies. Keep false for local http dev;
# set true in any environment served over https.
COOKIE_SECURE=false

# ---- MinIO / S3 object storage ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_change_me
S3_ENDPOINT=http://minio:9000
S3_BUCKET=desklite-attachments

# ---- App / CORS ----
# Origin the browser uses to reach the frontend (used for CORS on the API).
FRONTEND_ORIGIN=http://localhost:3000

# ---- Frontend ----
# Public URL the browser uses to reach the API (host, not the compose name).
NEXT_PUBLIC_API_URL=http://localhost:8000
