# =====================================================================
# DeskLite — PRODUCTION environment template (Contabo VPS / HTTPS).
# Copy on the server ONLY — never commit the real file:
#   cp .env.production.example .env
#   nano .env
# =====================================================================

# ---- PostgreSQL ----
POSTGRES_USER=desklite
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
POSTGRES_DB=desklite
DATABASE_URL=postgresql+psycopg://desklite:REPLACE_WITH_STRONG_RANDOM_PASSWORD@db:5432/desklite

# ---- Auth / JWT ----
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=true
# Only if API and app use separate subdomains (see deploy/Caddyfile.ip.example Option B):
# COOKIE_DOMAIN=yourdomain.com

# ---- MinIO / S3 ----
# Internal — backend uploads use the Docker service name.
S3_ENDPOINT=http://minio:9000
# Public — browser download links (Caddy → MinIO). REQUIRED in production.
# Example: https://files.yourdomain.com  OR  https://148.x.x.x/files if using path routing
S3_PUBLIC_ENDPOINT=https://files.yourdomain.com
MINIO_ROOT_USER=REPLACE_NOT_minioadmin
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
S3_BUCKET=desklite-attachments

# ---- App / CORS ----
# Exact HTTPS origins — no trailing slash.
FRONTEND_ORIGIN=https://app.yourdomain.com

# ---- Frontend (baked in at docker build time) ----
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# ---- Runtime ----
APP_ENV=production

# ---- Observability ----
LOG_LEVEL=INFO
LOG_JSON=true
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
